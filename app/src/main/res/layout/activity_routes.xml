<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/background_gradient">

    <TextView
        android:id="@+id/tvRoutesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mis Rutas"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btnRecordRoute"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Grabar Recorrido (GPS)"
        android:backgroundTint="#2196F3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnManualRoute"
        app:layout_constraintTop_toBottomOf="@+id/tvRoutesTitle"
        android:layout_marginEnd="5dp"/>

    <Button
        android:id="@+id/btnManualRoute"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Dibujar Manual"
        android:backgroundTint="#9C27B0"
        app:layout_constraintStart_toEndOf="@+id/btnRecordRoute"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvRoutesTitle"
        android:layout_marginStart="5dp"/>

    <LinearLayout
        android:id="@+id/layoutRecordingControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/btnRecordRoute">

        <TextView
            android:text="Grabando... Presiona para terminar"
            android:textColor="#FF0000"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnStopRecording"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DETENER Y GUARDAR"
            android:backgroundTint="#F44336"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRoutes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toTopOf="@+id/btnBackMainRoutes"
        app:layout_constraintTop_toBottomOf="@+id/layoutRecordingControls" />

    <Button
        android:id="@+id/btnBackMainRoutes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver"
        style="?android:attr/borderlessButtonStyle"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>